page {
  background: #f5f7fa;
  font-size: 28rpx;
  color: #212121;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 24rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(10, 35, 64, 0.08);
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a237e;
  margin-bottom: 20rpx;
}
.btn-primary {
  background: #1565c0;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
}
.btn-primary[disabled] {
  background: #9fc3ea;
  color: #fff;
}
.muted { color: #90a4ae; font-size: 24rpx; }
