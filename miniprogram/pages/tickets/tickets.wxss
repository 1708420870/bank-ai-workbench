.row { display: flex; gap: 16rpx; align-items: center; }
.qid { flex: 1; border: 1rpx solid #e0e0e0; border-radius: 10rpx; padding: 14rpx 20rpx; font-size: 28rpx; }
.qbtn { flex-shrink: 0; }
.fb-item { border-bottom: 1rpx solid #eceff1; padding: 20rpx 0; }
.fb-item:last-child { border-bottom: none; }
.fb-row1 { display: flex; justify-content: space-between; margin-bottom: 8rpx; }
.fbid { font-weight: 600; color: #1a237e; }
.st { font-size: 22rpx; padding: 2rpx 14rpx; border-radius: 999rpx; background: #eceff1; color: #546e7a; }
.st-CLOSED_AI { background: #e0f2f1; color: #00695c; }
.st-PENDING_HUMAN { background: #ffebee; color: #c62828; }
.st-HUMAN_ANSWERING { background: #fff8e1; color: #b26a00; }
.st-CLOSED_HUMAN { background: #e8eaf6; color: #3949ab; }
